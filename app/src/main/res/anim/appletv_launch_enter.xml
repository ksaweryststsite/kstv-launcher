<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_cubic">
    <!-- Tile-to-screen zoom is handled in Compose; keep app-window handoff subtle. -->
    <scale android:fromXScale="0.985" android:toXScale="1.0"
        android:fromYScale="0.985" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="125"/>
    <alpha android:fromAlpha="0.86" android:toAlpha="1.0" android:duration="125"/>
</set>
